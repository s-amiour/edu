{
  "name": "syllabus-navigator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "typecheck": "npm run build --workspace=backend",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npm run seed --workspace=backend",
    "db:generate": "npx prisma generate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "engines": {
    "node": "20.x"
  }
}
